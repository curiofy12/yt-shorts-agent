# Copy to .env for local testing. In GitHub Actions these come from repo secrets instead.
ANTHROPIC_API_KEY=
PEXELS_API_KEY=
YOUTUBE_CLIENT_SECRET_PATH=client_secret.json
YOUTUBE_TOKEN_PATH=token.json

# Niche steering (optional). Leave blank to pick fully automatically from
# trending topics; set this to bias the topic picker toward a lane, e.g.
# "science facts, psychology, space" so results stay on-brand.
CHANNEL_NICHE=
